{
  "version": 2,
  "installCommand": "npm install --include=dev && npm --prefix backend ci --include=dev",
  "buildCommand": "npm run vercel-build",

  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/[...slug].js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "(.*)",
      "dest": "/index.html"
    }
  ]
}
